NODE_ENV=production
PORT=3001
FRONTEND_URL=http://localhost:8510

APP_PORT=8510

ORACLE_USER=LIVESTACK_NATIVE
APP_SCHEMA_PASSWORD=replace-with-native-schema-password
ORACLE_CONNECTION_STRING=genaivasuatp_medium
ORACLE_WALLET_LOCATION=/opt/oracle/wallet
ORACLE_WALLET_PASSWORD=replace-with-wallet-password
ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=10
ORACLE_POOL_INCREMENT=1

OCI_GENAI_BASE_URL=https://inference.generativeai.us-chicago-1.oci.oraclecloud.com/openai/v1
OCI_GENAI_API_KEY=replace-with-oci-genai-api-key
OCI_GENAI_MODEL=replace-with-supported-oci-model-id
OCI_GENAI_PROJECT_OCID=
OCI_GENAI_JSON_MAX_TOKENS=1024
OCI_GENAI_TEXT_MAX_TOKENS=768
OCI_GENAI_TIMEOUT_MS=60000

DEMO_USAGE_COUNTER_ENABLED=false
